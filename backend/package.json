{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src/lib/communes.test.ts src/lib/placeSourceCatalog.test.ts src/lib/visitPlaceRanking.test.ts src/lib/visitPlaces.test.ts src/features/cities/cityService.test.ts src/features/cities/cityRoutes.test.ts src/features/places/placeService.test.ts src/features/places/placeRoutes.test.ts",
    "db:migrate": "tsx src/scripts/runMigrations.ts",
    "data:fetch-communes": "tsx src/scripts/fetchCommuneSources.ts",
    "data:fetch-visit-places": "tsx src/scripts/fetchVisitPlaceSources.ts",
    "data:import-communes": "tsx src/scripts/importCommunes.ts",
    "data:import-visit-places": "tsx src/scripts/importVisitPlaces.ts",
    "data:normalize-visit-places": "tsx src/scripts/normalizeVisitPlaces.ts",
    "data:refresh-communes": "npm run data:fetch-communes && npm run data:import-communes"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "adm-zip": "^0.5.16",
    "csv-parse": "^6.1.0",
    "fastify": "^5.3.3",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
